# Copy to .env (never commit .env). In CI these come from GitHub secrets.
POSTGRES_PASSWORD=change-me
INTERNAL_TOKEN=change-me-long-random
BANK_KEYS=key-alpha=BANKA,key-bravo=BANKB,key-charlie=BANKC,key-delta=BANKD
OPERATOR_KEY=key-operator
DEMO_MODE=true
ALLOW_RESET=true

# Kafka (KRaft, SASL). Generate a real cluster id:  docker run --rm <kafka-image> kafka-storage.sh random-uuid
# Passwords: 12+ chars of [A-Za-z0-9._~+/=-]. Example values below are for local use only.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_ADMIN_PASSWORD=change-me-kafka-admin
KAFKA_APP_PASSWORD=change-me-kafka-app
